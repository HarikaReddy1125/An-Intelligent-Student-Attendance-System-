def get_class_students(conn, timetable_row):

    students = conn.execute(
        """
        SELECT id, student_id, name, department, year, section
        FROM students
        ORDER BY student_id
        """
    ).fetchall()

    def norm(value):
        return str(value or "").strip().casefold()

    filters = [
        (field, norm(timetable_row[field]))
        for field in ("department", "year", "section")
        if (
            field in timetable_row.keys()
            and norm(timetable_row[field])
        )
    ]

    if not filters:
        return students

    return [
        student
        for student in students
        if all(
            norm(student[field]) == expected
            for field, expected in filters
        )
    ]


