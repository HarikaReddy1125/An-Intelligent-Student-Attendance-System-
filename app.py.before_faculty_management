# ============================================================
# FINALIZE CAMERA ATTENDANCE
# ============================================================

def finalize_class_attendance(
    timetable_id,
    selected_date,
    session_end=None
):

    if selected_date != date.today().isoformat():
        return {
            "success": False,
            "message": (
                "Automatic finalization is only available "
                "for today's session."
            )
        }, 400

    conn = get_db_connection()

    try:
        timetable = conn.execute(
            """
            SELECT *
            FROM timetable
            WHERE id = ?
              AND (active = 1 OR active IS NULL)
            """,
            (timetable_id,)
        ).fetchone()

        if timetable is None:
            return {
                "success": False,
                "message": (
                    "The selected timetable class was not found "
                    "or is inactive."
                )
            }, 404

        window = get_camera_window_for_class(
            timetable,
            selected_date
        )

        if window is None:
            return {
                "success": False,
                "message": (
                    "This class is not scheduled on the selected date."
                )
            }, 400

        if datetime.now() < window["end"]:
            return {
                "success": False,
                "message": (
                    f"Attendance can be finalized at "
                    f"{window['end_text']}."
                ),
                "finalize_at": window["end_text"]
            }, 409

        absent_added = 0

        for student in get_class_students(
            conn,
            timetable
        ):

            exists = conn.execute(
                """
                SELECT id
                FROM attendance
                WHERE student_id = ?
                  AND timetable_id = ?
                  AND date = ?
                LIMIT 1
                """,
                (
                    student["id"],
                    timetable_id,
                    selected_date
                )
            ).fetchone()

            if exists:
                continue

            conn.execute(
                """
                INSERT INTO attendance
                (
                    student_id,
                    timetable_id,
                    date,
                    time,
                    status,
                    confidence
                )
                VALUES (?, ?, ?, ?, 'Absent', NULL)
                """,
                (
                    student["id"],
                    timetable_id,
                    selected_date,
                    finalize_at.strftime("%H:%M:%S")
                )
            )

            absent_added += 1

        conn.commit()

        return {
            "success": True,
            "message": "Attendance finalized.",
            "timetable_id": int(timetable_id),
            "date": selected_date,
            "finalized_at": window["end"].strftime("%H:%M:%S"),
            "absent_added": absent_added,
            "records": _class_attendance_rows(
                conn,
                timetable,
                selected_date
            )
        }, 200

    finally:
        conn.close()


# ============================================================
# MARK BROWSER ATTENDANCE
# ============================================================

def mark_browser_attendance(
    student_database_id,
    timetable_id,
    similarity
):

    now = datetime.now()

    attendance_date = now.strftime("%Y-%m-%d")
    attendance_time = now.strftime("%H:%M:%S")

    conn = get_db_connection()

    try:
        existing = conn.execute(
            """
            SELECT status
            FROM attendance
            WHERE student_id = ?
              AND timetable_id = ?
              AND date = ?
            LIMIT 1
            """,
            (
                student_database_id,
                timetable_id,
                attendance_date
            )
        ).fetchone()

        if existing:
            return {
                "message": (
                    "Attendance was already marked for this class today."
                ),
                "status": existing["status"],
                "already_marked": True
            }

        timetable_columns = get_table_columns("timetable")

        status = "Present"

        if "late_after" in timetable_columns:

            late_row = conn.execute(
                """
                SELECT late_after
                FROM timetable
                WHERE id = ?
                """,
                (timetable_id,)
            ).fetchone()

            if late_row and late_row["late_after"]:
                try:
                    hour, minute = map(
                        int,
                        late_row["late_after"].split(":")[:2]
                    )

                    if now.hour * 60 + now.minute > hour * 60 + minute:
                        status = "Late"

                except (ValueError, AttributeError):
                    app.logger.warning(
                        "Invalid late_after value for timetable %s",
                        timetable_id
                    )

        conn.execute(
            """
            INSERT INTO attendance
            (
                student_id,
                timetable_id,
                date,
                time,
                status,
                confidence
            )
            VALUES (?, ?, ?, ?, ?, ?)
            """,
            (
                student_database_id,
                timetable_id,
                attendance_date,
                attendance_time,
                status,
                float(similarity)
            )
        )

        conn.commit()

        return {
            "message": "Attendance marked successfully.",
            "status": status,
            "already_marked": False
        }

    finally:
        conn.close()


