@app.route("/faculty")
@app.route("/faculty/dashboard")
@role_required("faculty")
def faculty_dashboard():
    faculty, faculty_name, username = faculty_identity()

    if faculty is None:
        flash("Faculty account not found.", "error")
        return redirect(url_for("logout"))

    today = date.today()
    today_iso = today.isoformat()
    now = datetime.now()

    conn = get_db_connection()

    try:
        all_rows = all_timetable_rows(conn)

        # Only timetable classes assigned to the logged-in faculty.
        my_classes = [
            dict(row)
            for row in all_rows
            if faculty_matches_timetable(
                row, faculty_name, username
            )
        ]

        def prepare_class(item):
            item["subject_name"] = (
                item.get("subject_name")
                or item.get("subject")
                or item.get("course_code")
                or item.get("class_name")
                or "Class"
            )
            item["room_no"] = (
                item.get("room_no")
                or item.get("room")
                or item.get("classroom")
                or "-"
            )
            return item

        for item in my_classes:
            prepare_class(item)

        # Find this faculty's classes scheduled for today.
        today_aliases = {
            str(value).strip().lower()
            for value in get_day_aliases(today_iso)
        }

        today_classes = [
            item.copy()
            for item in my_classes
            if str(item.get("day") or "").strip().lower()
            in today_aliases
        ]

        today_classes.sort(
            key=lambda item: (
                _time_value(item.get("start_time"))
                or datetime.strptime("23:59", "%H:%M").time()
            )
        )

        # Find the next class today; if none remains, find the
        # next scheduled class on a future date.
        next_class = None

        for day_offset in range(0, 15):
            candidate_date = today + timedelta(days=day_offset)
            candidate_iso = candidate_date.isoformat()

            day_aliases = {
                str(value).strip().lower()
                for value in get_day_aliases(candidate_iso)
            }

            day_classes = [
                item.copy()
                for item in my_classes
                if str(item.get("day") or "").strip().lower()
                in day_aliases
            ]

            day_classes.sort(
                key=lambda item: (
                    _time_value(item.get("start_time"))
                    or datetime.strptime("23:59", "%H:%M").time()
                )
            )

            for item in day_classes:
                start_time = _time_value(item.get("start_time"))

                if start_time is None:
                    continue

                class_datetime = datetime.combine(
                    candidate_date, start_time
                )

                if class_datetime > now:
                    next_class = prepare_class(item.copy())
                    next_class["display_date"] = (
                        "Today" if day_offset == 0
                        else candidate_date.strftime("%A, %d %b %Y")
                    )
                    next_class["weekday"] = candidate_date.strftime("%A")
                    break

            if next_class:
                break

        # Count present/late records only for this faculty's classes.
        my_timetable_ids = [
            item["id"]
            for item in my_classes
            if item.get("id") is not None
        ]

        timetable_count = len(my_classes)
        today_present = 0
        total_attendance = 0
        today_attendance_records = []

        if my_timetable_ids:
            placeholders = ",".join(
                "?" for _ in my_timetable_ids
            )

            today_present = conn.execute(
                f"""
                SELECT COUNT(*)
                FROM attendance a
                WHERE a.date = ?
                  AND lower(trim(coalesce(a.status, '')))
                      IN ('present', 'late')
                  AND a.timetable_id IN ({placeholders})
                """,
                (today_iso, *my_timetable_ids)
            ).fetchone()[0]

            total_attendance = conn.execute(
                f"""
                SELECT COUNT(*)
                FROM attendance
                WHERE timetable_id IN ({placeholders})
                """,
                tuple(my_timetable_ids)
            ).fetchone()[0]

            # Retrieve today's actual attendance rows for the
            # dashboard table.
            #
            # The timetable row supplies subject and faculty details.
            # The student row supplies the roll number and name.
            rows = conn.execute(
                f"""
                SELECT
                    s.student_id AS roll_number,
                    s.name AS student_name,
                    a.status AS status,
                    a.date AS attendance_date,
                    a.time AS attendance_time,
                    t.*
                FROM attendance AS a
                INNER JOIN students AS s
                    ON s.id = a.student_id
                INNER JOIN timetable AS t
                    ON t.id = a.timetable_id
                WHERE a.date = ?
                  AND a.timetable_id IN ({placeholders})
                ORDER BY t.start_time, s.student_id
                """,
                (today_iso, *my_timetable_ids)
            ).fetchall()

            for row in rows:
                record = dict(row)

                record["subject"] = (
                    record.get("subject_name")
                    or record.get("subject")
                    or record.get("course_code")
                    or record.get("class_name")
                    or "Class"
                )

                record["faculty"] = (
                    record.get("faculty_name")
                    or record.get("faculty")
                    or faculty_name
                    or username
                    or "-"
                )

                record["date"] = (
                    record.get("attendance_date") or today_iso
                )

                record["time"] = (
                    record.get("attendance_time") or "--"
                )

                today_attendance_records.append(record)

        return render_template(
            "faculty_dashboard.html",
            faculty=faculty,
            faculty_name=faculty_name,
            today_date=today_iso,
            today_classes=today_classes,
            next_class=next_class,
            timetable_count=timetable_count,
            today_present=today_present,
            total_attendance=total_attendance,
            today_attendance_records=today_attendance_records
        )

    finally:
        conn.close()


