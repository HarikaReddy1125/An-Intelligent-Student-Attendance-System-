DAY_ALIASES = {
    "Mon": ["mon", "monday"],
    "Tue": ["tue", "tuesday"],
    "Wed": ["wed", "wednesday"],
    "Thu": ["thu", "thursday"],
    "Fri": ["fri", "friday"],
    "Sat": ["sat", "saturday"],
    "Sun": ["sun", "sunday"]
}


def get_day_aliases(selected_date):
    try:
        selected_day = datetime.strptime(
            selected_date,
            "%Y-%m-%d"
        ).strftime("%a")

        return DAY_ALIASES.get(selected_day, [])

    except (ValueError, TypeError):
        return []


