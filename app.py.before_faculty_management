@app.route(
    "/api/attendance/camera/frame",
    methods=["POST"]
)
@role_required("admin")
def browser_camera_frame():

    # Verify that a session is active and has a locked class.
    if not session.get("camera_session_active", False):
        return jsonify({
            "success": False,
            "message": "Start a camera session first."
        }), 400

    timetable_id = session.get("camera_timetable_id")
    session_date = session.get("camera_session_date")
    session_start_text = session.get("camera_session_start")
    session_end_text = session.get("camera_session_end")

    if not all([
        timetable_id,
        session_date,
        session_start_text,
        session_end_text
    ]):
        session["camera_session_active"] = False

        return jsonify({
            "success": False,
            "message": (
                "Camera session information is incomplete. "
                "Please start a new session."
            )
        }), 400

    try:
        session_start = datetime.fromisoformat(
            session_start_text
        )
        session_end = datetime.fromisoformat(
            session_end_text
        )
    except (TypeError, ValueError):
        session["camera_session_active"] = False

        return jsonify({
            "success": False,
            "message": "Invalid camera session timestamps."
        }), 400

    now = datetime.now()

    # This endpoint supports today's attendance only.
    if session_date != date.today().isoformat():
        session["camera_session_active"] = False

        return jsonify({
            "success": False,
            "message": (
                "This session is no longer valid for today's date."
            )
        }), 410

    # Reject frames before the session starts or after it expires.
    if now < session_start:
        return jsonify({
            "success": False,
            "message": "The camera session has not started yet."
        }), 409

    if now >= session_end:
        session["camera_session_active"] = False

        return jsonify({
            "success": False,
            "state": "session_expired",
            "message": (
                "The 20-minute attendance session has ended. "
                "Finalize attendance now."
            ),
            "timetable_id": int(timetable_id)
        }), 410

    # Decode the camera frame.
    payload = request.get_json(silent=True) or {}
    image_data = payload.get("image", "")

    if not image_data:
        return jsonify({
            "success": False,
            "message": "No camera image was received."
        }), 400

    try:
        if "," in image_data:
            image_data = image_data.split(",", 1)[1]

        image_bytes = base64.b64decode(
            image_data,
            validate=True
        )

        frame = cv2.imdecode(
            np.frombuffer(image_bytes, dtype=np.uint8),
            cv2.IMREAD_COLOR
        )

        if frame is None:
            return jsonify({
                "success": False,
                "message": (
                    "The camera image could not be decoded."
                )
            }), 400

        detector, recognizer = get_camera_models()

        height, width = frame.shape[:2]
        detector.setInputSize((width, height))

        _, faces = detector.detect(frame)

        if faces is None or len(faces) == 0:
            return jsonify({
                "success": True,
                "state": "no_face",
                "message": (
                    "No face detected. Please look toward the camera."
                )
            })

        # Process the largest detected face in this frame.
        face = max(
            faces,
            key=lambda item: float(item[2] * item[3])
        )

        aligned = recognizer.alignCrop(frame, face)
        feature = recognizer.feature(aligned).flatten()

        feature_norm = float(np.linalg.norm(feature))

        if feature_norm == 0:
            return jsonify({
                "success": True,
                "state": "unrecognized",
                "message": (
                    "Could not extract a usable face feature."
                )
            })

        feature /= feature_norm

        enrolled = load_enrolled_face_embeddings()

        best_student = None
        best_similarity = -1.0

        for student in enrolled:
            if student["embedding"].shape != feature.shape:
                continue

            similarity = float(
                np.dot(feature, student["embedding"])
            )

            if similarity > best_similarity:
                best_student = student
                best_similarity = similarity

        if (
            best_student is None
            or best_similarity < FACE_SIMILARITY_THRESHOLD
        ):
            return jsonify({
                "success": True,
                "state": "unrecognized",
                "message": (
                    "Face not recognized. Please try again."
                )
            })

        # Recheck expiry immediately before writing attendance.
        now = datetime.now()

        if now >= session_end:
            session["camera_session_active"] = False

            return jsonify({
                "success": False,
                "state": "session_expired",
                "message": (
                    "The 20-minute attendance session has ended."
                ),
                "timetable_id": int(timetable_id)
            }), 410

        # IMPORTANT: use the class locked at session start.
        # Do not call get_current_timetable_class() here.
        result = mark_browser_attendance(
            best_student["database_id"],
            int(timetable_id),
            best_similarity
        )

        return jsonify({
            "success": True,
            "state": "marked",
            "message": result["message"],
            "name": best_student["name"],
            "roll_number": best_student["student_id"],
            "status": result["status"],
            "similarity": round(best_similarity, 3),
            "already_marked": result["already_marked"],
            "timetable_id": int(timetable_id),
            "session_end": session_end.isoformat()
        })

    except Exception:
        app.logger.exception(
            "Browser camera frame processing failed"
        )

        return jsonify({
            "success": False,
            "message": (
                "Unable to process this camera frame. "
                "Check the server logs."
            )
        }), 500

