@app.route(
    "/api/attendance/camera/finalize",
    methods=["POST"]
)
@role_required("admin")
def browser_camera_finalize():

    locked_timetable_id = session.get("camera_timetable_id")
    session_date = session.get("camera_session_date")
    session_end_text = session.get("camera_session_end")

    if not all([
        locked_timetable_id,
        session_date,
        session_end_text
    ]):
        return jsonify({
            "success": False,
            "message": (
                "No valid camera session was found. "
                "Please start attendance first."
            )
        }), 400

    payload = request.get_json(silent=True) or {}

    # Do not allow the browser to finalize a different class.
    try:
        requested_timetable_id = int(
            payload.get("timetable_id")
        )
    except (TypeError, ValueError):
        requested_timetable_id = None

    if requested_timetable_id != int(locked_timetable_id):
        return jsonify({
            "success": False,
            "message": (
                "The requested class does not match "
                "the active camera session."
            )
        }), 400

    selected_date = str(
        payload.get("date") or date.today().isoformat()
    )

    if selected_date != session_date:
        return jsonify({
            "success": False,
            "message": (
                "The requested date does not match "
                "the camera session date."
            )
        }), 400

    if selected_date != date.today().isoformat():
        return jsonify({
            "success": False,
            "message": "Only today's camera session can be finalized."
        }), 400

    try:
        session_end = datetime.fromisoformat(session_end_text)
    except (TypeError, ValueError):
        return jsonify({
            "success": False,
            "message": "The camera session end time is invalid."
        }), 400

    if datetime.now() < session_end:
        return jsonify({
            "success": False,
            "message": (
                "The 20-minute attendance session is still running."
            ),
            "finalize_at": session_end.strftime("%H:%M:%S")
        }), 409

    result, status_code = finalize_class_attendance(
        int(locked_timetable_id),
        selected_date,
        session_end=session_end
    )

    if status_code == 200 and result.get("success"):
        session["camera_session_active"] = False
        session["camera_session_finalized"] = True

    return jsonify(result), status_code

