    conn.row_factory = sqlite3.Row
    return conn


def get_table_columns(table_name):
    conn = get_db_connection()

    try:
        rows = conn.execute(
            f'PRAGMA table_info("{table_name}")'
        ).fetchall()

        return {row["name"] for row in rows}

    finally:
        conn.close()


