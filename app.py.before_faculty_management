def load_enrolled_face_embeddings():

    conn = get_db_connection()

    try:
        rows = conn.execute(
            """
            SELECT id, student_id, name, face_encoding
            FROM students
            WHERE face_encoding IS NOT NULL
            ORDER BY student_id
            """
        ).fetchall()

    finally:
        conn.close()

    enrolled = []

    for row in rows:
        try:
            raw = row["face_encoding"]

            if raw is None:
                continue

            embedding = np.frombuffer(
                raw,
                dtype=np.float32
            ).copy()

            norm = float(np.linalg.norm(embedding))

            if embedding.size == 0 or norm == 0:
                continue

            embedding /= norm

            enrolled.append({
                "database_id": row["id"],
                "student_id": row["student_id"],
                "name": row["name"],
                "embedding": embedding
            })

        except (TypeError, ValueError):
            app.logger.warning(
                "Skipping invalid student face encoding."
            )

    return enrolled


def browser_face_position(face, frame_width):

    x = float(face[0])
    face_width = float(face[2])

    center_ratio = (
        x + face_width / 2.0
    ) / float(frame_width)

    if center_ratio < 0.35:
        return "LEFT"

    if center_ratio > 0.65:
        return "RIGHT"

    return "CENTER"


# ============================================================
# TIME HELPERS
# ============================================================

def _time_value(value):

    if not value:
        return None

    for fmt in ("%H:%M", "%H:%M:%S"):
        try:
            return datetime.strptime(
                str(value).strip(),
                fmt
            ).time()

        except ValueError:
            pass

    return None


def get_camera_window_for_class(
    timetable_row,
    selected_date=None
):

    if timetable_row is None:
        return None

    selected_date = (
        selected_date or date.today().isoformat()
    )

    try:
        class_date = date.fromisoformat(selected_date)

    except (TypeError, ValueError):
        return None

    aliases = {
        item.lower()
        for item in get_day_aliases(selected_date)
    }

    if (
        str(timetable_row["day"] or "").strip().lower()
        not in aliases
    ):
        return None

    start_time = _time_value(
        timetable_row["start_time"]
    )

    if start_time is None:
        return None

    class_start = datetime.combine(
        class_date,
        start_time
    )

    window_start = class_start - timedelta(
        minutes=CAMERA_MINUTES_BEFORE_CLASS
    )

    window_end = window_start + timedelta(
        minutes=CAMERA_WINDOW_MINUTES
    )

    return {
        "start": window_start,
        "end": window_end,
        "start_text": window_start.strftime("%H:%M"),
        "end_text": window_end.strftime("%H:%M")
    }


def get_current_timetable_class(now=None):

    now = now or datetime.now()

    aliases = DAY_ALIASES.get(
        now.strftime("%a"),
        []
    )

    if not aliases:
        return None

    placeholders = ",".join("?" for _ in aliases)

    conn = get_db_connection()

    try:
        rows = conn.execute(
            f"""
            SELECT *
            FROM timetable
            WHERE lower(trim(day)) IN ({placeholders})
              AND (active = 1 OR active IS NULL)
            ORDER BY start_time
            """,
            tuple(item.lower() for item in aliases)
        ).fetchall()

        for row in rows:

            window = get_camera_window_for_class(
                row,
                now.date().isoformat()
            )

            if (
                window
                and window["start"] <= now < window["end"]
            ):
                item = dict(row)

                item["camera_start_time"] = (
                    window["start_text"]
                )

                item["camera_end_time"] = (
                    window["end_text"]
                )

                item["camera_window_start"] = (
                    window["start"]
                )

                item["camera_window_end"] = (
                    window["end"]
                )

                return item

        return None

    finally:
        conn.close()


