@app.route("/faculty/attendance")
@role_required("faculty")
def faculty_attendance():
    faculty, faculty_name, username = faculty_identity()

    if faculty is None:
        flash("Faculty account not found.", "error")
        return redirect(url_for("logout"))

    # Get and validate the selected date.
    selected_date = request.args.get(
        "date", date.today().isoformat()
    ).strip()

    try:
        date.fromisoformat(selected_date)
    except (ValueError, TypeError):
        selected_date = date.today().isoformat()

    # Get the selected timetable class ID, if any.
    selected_timetable_id = request.args.get(
        "timetable_id", ""
    ).strip()

    conn = get_db_connection()

    try:
        # Get ALL active classes scheduled for the selected date,
        # regardless of which faculty member is assigned.
        scheduled = scheduled_classes_for_date(
            conn, selected_date
        )

        classes = [
            dict(row)
            for row in scheduled
        ]

        # Prepare consistent subject and room labels.
        for item in classes:
            item["subject_name"] = (
                item.get("subject_name")
                or item.get("subject")
                or item.get("course_code")
                or item.get("class_name")
                or "Class"
            )

            item["room_no"] = (
                item.get("room_no")
                or item.get("room")
                or item.get("classroom")
                or "-"
            )

        # Find the selected class among all scheduled classes.
        selected_class = None
        attendance_records = []

        if selected_timetable_id:
            try:
                class_id = int(selected_timetable_id)
            except (ValueError, TypeError):
                class_id = None

            if class_id is not None:
                selected_class = next(
                    (
                        item for item in classes
                        if str(item.get("id")) == str(class_id)
                    ),
                    None
                )

            # Load attendance only when the class is scheduled
            # for the selected date.
            if selected_class:
                attendance_records = _class_attendance_rows(
                    conn,
                    selected_class,
                    selected_date
                )

        # Attendance status counts.
        present_count = sum(
            1 for row in attendance_records
            if str(row.get("status", "")).strip().lower()
            == "present"
        )

        late_count = sum(
            1 for row in attendance_records
            if str(row.get("status", "")).strip().lower()
            == "late"
        )

        absent_count = sum(
            1 for row in attendance_records
            if str(row.get("status", "")).strip().lower()
            == "absent"
        )

        total_students = len(attendance_records)
        marked_count = 0

        if selected_class:
            marked_count = conn.execute(
                """
                SELECT COUNT(*)
                FROM attendance
                WHERE timetable_id = ?
                  AND date = ?
                """,
                (selected_class["id"], selected_date)
            ).fetchone()[0]

        unmarked_count = max(
            0, total_students - marked_count
        )

        finalized = (
            bool(total_students)
            and marked_count >= total_students
        )

        return render_template(
            "faculty_attendance.html",
            faculty=faculty,
            selected_date=selected_date,
            classes=classes,
            selected_timetable_id=selected_timetable_id,
            selected_class=selected_class,
            attendance_records=attendance_records,
            present_count=present_count,
            late_count=late_count,
            absent_count=absent_count,
            unmarked_count=unmarked_count,
            total_students=total_students,
            marked_count=marked_count,
            finalized=finalized
        )

    finally:
        conn.close()




