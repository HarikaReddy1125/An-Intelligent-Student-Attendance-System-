def format_time_12h(value):
    if not value:
        return ""

    value = str(value).strip()

    for fmt in (
        "%H:%M:%S",
        "%H:%M",
        "%I:%M %p",
        "%I:%M:%S %p"
    ):
        try:
            return datetime.strptime(
                value,
                fmt
            ).strftime("%I:%M %p").lstrip("0")

        except ValueError:
            continue

    return value


