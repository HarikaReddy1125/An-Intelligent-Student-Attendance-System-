@app.route(
    "/api/attendance/camera/start",
    methods=["POST"]
)
@role_required("admin")
def browser_camera_start():

    # Prevent accidentally replacing an active session.
    if session.get("camera_session_active"):
        try:
            existing_end = datetime.fromisoformat(
                session.get("camera_session_end", "")
            )

            if datetime.now() < existing_end:
                return jsonify({
                    "success": False,
                    "message": (
                        "A camera attendance session is already active."
                    ),
                    "timetable_id": session.get(
                        "camera_timetable_id"
                    ),
                    "session_end": existing_end.isoformat()
                }), 409

        except (TypeError, ValueError):
            pass

        # Expired or invalid session
        session["camera_session_active"] = False

    # Find the timetable class scheduled right now.
    current_class = get_current_timetable_class()

    if not current_class:
        return jsonify({
            "success": False,
            "message": (
                "No class is currently scheduled for attendance. "
                "Please start during a scheduled class window."
            )
        }), 409

    try:
        get_camera_models()
        enrolled = load_enrolled_face_embeddings()

        if not enrolled:
            return jsonify({
                "success": False,
                "message": (
                    "No enrolled face encodings were found."
                )
            }), 400

    except Exception:
        app.logger.exception(
            "Unable to initialize browser camera attendance"
        )

        return jsonify({
            "success": False,
            "message": (
                "Camera attendance could not initialize. "
                "Check the model files and server logs."
            )
        }), 500

    # Lock the selected timetable class for this session.
    session_start = datetime.now()
    session_end = session_start + timedelta(minutes=20)

    session["camera_session_active"] = True
    session["camera_timetable_id"] = int(current_class["id"])
    session["camera_session_date"] = session_start.date().isoformat()
    session["camera_session_start"] = session_start.isoformat()
    session["camera_session_end"] = session_end.isoformat()

    return jsonify({
        "success": True,
        "message": (
            "Camera attendance started. "
            "The selected class is locked for 20 minutes."
        ),
        "class_name": current_class.get("class_name") or "",
        "subject": (
            current_class.get("subject_name")
            or current_class.get("subject")
            or ""
        ),
        "has_active_class": True,
        "timetable_id": int(current_class["id"]),
        "camera_start_time": session_start.strftime("%H:%M:%S"),
        "camera_end_time": session_end.strftime("%H:%M:%S"),
        "session_start": session_start.isoformat(),
        "session_end": session_end.isoformat(),
        "duration_minutes": 20
    })

