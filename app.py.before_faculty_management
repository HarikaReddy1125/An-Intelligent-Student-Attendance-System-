def api_timetable_by_day(day_name):

    normalized = day_name.strip().lower()

    aliases = None

    for short_day, day_aliases in DAY_ALIASES.items():
        if normalized in [
            value.lower()
            for value in day_aliases
        ]:
            aliases = [
                value.lower()
                for value in day_aliases
            ]
            break

    if aliases is None:
        return jsonify({
            "success": False,
            "message": "Invalid day name."
        }), 400

    placeholders = ",".join("?" for _ in aliases)

    conn = get_db_connection()

    try:
        rows = conn.execute(
            f"""
            SELECT *
            FROM timetable
            WHERE lower(trim(day)) IN ({placeholders})
            ORDER BY start_time
            """,
            aliases
        ).fetchall()

        return jsonify({
            "success": True,
            "day": day_name,
            "classes": [
                dict(row)
                for row in rows
            ]
        })

    finally:
        conn.close()


