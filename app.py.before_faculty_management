@app.route("/student")
@role_required("student")
def student_dashboard():
    from datetime import datetime, timedelta

    student = get_logged_in_student()

    if student is None:
        session.clear()
        return redirect(url_for("login"))

    today = date.today()
    now_time = datetime.now().time()

    # --------------------------------------------------------
    # VALIDATE SELECTED DATE
    # --------------------------------------------------------
    selected_date = request.args.get("date", today.isoformat())

    try:
        selected = date.fromisoformat(selected_date)
        selected_date = selected.isoformat()
    except (TypeError, ValueError):
        selected = today
        selected_date = today.isoformat()

    display_date = selected.strftime("%d/%m/%Y")

    # --------------------------------------------------------
    # ATTENDANCE PERIOD
    # --------------------------------------------------------
    overall_start = date(2026, 7, 6)
    overall_end = date(2026, 11, 2)

    # Do not count future classes in attendance statistics.
    calculation_end = min(overall_end, today)

    month_start = selected.replace(day=1)
    monthly_start = max(month_start, overall_start)
    monthly_end = min(selected, overall_end, today)

    # --------------------------------------------------------
    # OPEN DATABASE
    # --------------------------------------------------------
    conn = get_db_connection()

    try:
        # ----------------------------------------------------
        # LOAD TIMETABLE ROWS FOR ALL REQUIRED DATES
        # ----------------------------------------------------
        timetable_by_day = {}

        current_day = min(
            overall_start,
            monthly_start,
            selected
        )

        data_end = max(
            calculation_end,
            monthly_end,
            selected
        )

        while current_day <= data_end:
            day_key = current_day.isoformat()

            aliases = {
                str(item).strip().lower()
                for item in get_day_aliases(day_key)
                if str(item).strip()
            }

            if aliases:
                placeholders = ",".join("?" for _ in aliases)

                rows = conn.execute(
                    f"""
                    SELECT *
                    FROM timetable
                    WHERE lower(trim(day)) IN ({placeholders})
                      AND (active = 1 OR active IS NULL)
                    ORDER BY start_time
                    """,
                    tuple(sorted(aliases))
                ).fetchall()

                timetable_by_day[day_key] = [
                    dict(row) for row in rows
                ]
            else:
                timetable_by_day[day_key] = []

            current_day += timedelta(days=1)

        # ----------------------------------------------------
        # LOAD ATTENDANCE RECORDS
        # ----------------------------------------------------
        attendance_rows = conn.execute(
            """
            SELECT
                rowid AS attendance_rowid,
                date,
                timetable_id,
                status,
                time
            FROM attendance
            WHERE student_id = ?
              AND date >= ?
              AND date <= ?
            ORDER BY date, timetable_id, rowid
            """,
            (
                student["id"],
                overall_start.isoformat(),
                overall_end.isoformat()
            )
        ).fetchall()

        attendance_by_key = {}

        # If duplicate records exist, the last row is retained.
        for record in attendance_rows:
            key = (
                record["date"],
                record["timetable_id"]
            )
            attendance_by_key[key] = dict(record)

        # ----------------------------------------------------
        # ATTENDANCE HELPERS
        # ----------------------------------------------------
        def is_present(status):
            return str(status or "").strip().lower() in (
                "present",
                "late"
            )

        def class_has_finished(class_date, timetable_row):
            """Return True only when the scheduled class has ended."""
            if class_date < today:
                return True

            if class_date > today:
                return False

            end_value = str(
                timetable_row.get("end_time") or ""
            ).strip()

            if not end_value:
                return False

            parsed_end = None

            for time_format in ("%H:%M:%S", "%H:%M"):
                try:
                    parsed_end = datetime.strptime(
                        end_value,
                        time_format
                    ).time()
                    break
                except ValueError:
                    continue

            if parsed_end is None:
                return False

            return parsed_end <= now_time

        def prepare_class(timetable_row, class_date):
            """Add attendance and display fields to a timetable row."""
            item = dict(timetable_row)

            timetable_id = item.get("id")
            key = (class_date.isoformat(), timetable_id)
            record = attendance_by_key.get(key)

            if record is not None:
                item["status"] = (
                    record.get("status") or "Not marked"
                )
                item["time"] = record.get("time") or ""
            elif class_has_finished(class_date, item):
                item["status"] = "Absent"
                item["time"] = ""
            else:
                item["status"] = "Not marked"
                item["time"] = ""

            item["subject"] = (
                item.get("subject_name")
                or item.get("subject")
                or item.get("course_code")
                or item.get("class_name")
                or "Class"
            )

            item["class_name"] = (
                item.get("class_name")
                or item.get("subject_name")
                or item.get("subject")
                or item.get("course_code")
                or "Class"
            )

            item["faculty_name"] = (
                item.get("faculty_name")
                or item.get("faculty")
                or "-"
            )

            item["room"] = (
                item.get("room")
                or item.get("room_no")
                or item.get("classroom")
                or "-"
            )

            return item

        # ----------------------------------------------------
        # CALCULATE ATTENDANCE FOR A DATE RANGE
        # ----------------------------------------------------
        def calculate_period(period_start, period_end):
            attended = 0
            absent = 0
            eligible_total = 0

            if period_end < period_start:
                return {
                    "present": 0,
                    "absent": 0,
                    "total": 0,
                    "percentage": 0.0
                }

            current = period_start

            while current <= period_end:
                day_key = current.isoformat()

                scheduled_classes = timetable_by_day.get(
                    day_key, []
                )

                for timetable_row in scheduled_classes:
                    timetable_id = timetable_row.get("id")
                    record = attendance_by_key.get(
                        (day_key, timetable_id)
                    )

                    if record is not None:
                        # A saved record is counted regardless of status.
                        eligible_total += 1

                        if is_present(record.get("status")):
                            attended += 1
                        else:
                            absent += 1

                    elif class_has_finished(
                        current,
                        timetable_row
                    ):
                        # Missing records count as absent only after
                        # the class's scheduled end time.
                        eligible_total += 1
                        absent += 1

                current += timedelta(days=1)

            percentage = (
                round(attended * 100.0 / eligible_total, 1)
                if eligible_total
                else 0.0
            )

            return {
                "present": attended,
                "absent": absent,
                "total": eligible_total,
                "percentage": percentage
            }

        # ----------------------------------------------------
        # DAILY TIMETABLE
        # ----------------------------------------------------
        classes = [
            prepare_class(row, selected)
            for row in timetable_by_day.get(selected_date, [])
        ]

        daily_stats = calculate_period(selected, selected)

        total_classes = len(classes)
        present_count = daily_stats["present"]
        absent_count = daily_stats["absent"]
        day_eligible_total = daily_stats["total"]
        day_percentage = daily_stats["percentage"]

        # ----------------------------------------------------
        # OVERALL ATTENDANCE
        # 6 JULY 2026 THROUGH 2 NOVEMBER 2026
        # ----------------------------------------------------
        overall_stats = calculate_period(
            overall_start,
            calculation_end
        )

        overall_present = overall_stats["present"]
        overall_absent = overall_stats["absent"]
        overall_total = overall_stats["total"]
        overall_percentage = overall_stats["percentage"]

        overall_warning = (
            overall_total == 0
            or overall_percentage < 75
        )

        # ----------------------------------------------------
        # MONTHLY ATTENDANCE
        # MONTH START THROUGH SELECTED DATE
        # ----------------------------------------------------
        monthly_stats = calculate_period(
            monthly_start,
            monthly_end
        )

        monthly_present = monthly_stats["present"]
        monthly_absent = monthly_stats["absent"]
        monthly_total = monthly_stats["total"]
        monthly_percentage = monthly_stats["percentage"]

        monthly_warning = (
            monthly_total == 0
            or monthly_percentage < 75
        )

        # ----------------------------------------------------
        # RENDER DASHBOARD
        # ----------------------------------------------------
        return render_template(
            "student_dashboard.html",
            student=student,
            selected_date=selected_date,
            display_date=display_date,
            classes=classes,

            # Daily statistics
            total_classes=total_classes,
            present_count=present_count,
            absent_count=absent_count,
            day_eligible_total=day_eligible_total,
            day_percentage=day_percentage,

            # Overall statistics
            overall_start=overall_start.isoformat(),
            overall_end=overall_end.isoformat(),
            overall_start_date=overall_start.isoformat(),
            overall_end_date=overall_end.isoformat(),
            overall_present=overall_present,
            overall_absent=overall_absent,
            overall_total=overall_total,
            overall_percentage=overall_percentage,
            overall_warning=overall_warning,

            # Monthly statistics
            monthly_present=monthly_present,
            monthly_absent=monthly_absent,
            monthly_total=monthly_total,
            monthly_percentage=monthly_percentage,
            monthly_warning=monthly_warning,

            active_page="dashboard"
        )

    finally:
        conn.close()


