                url_for(
                    "faculty_attendance",
                    date=selected_date,
                    timetable_id=timetable_id
                )
            )

        if datetime.now() < window["end"]:
            flash(
                f"Attendance can be finalized after "
                f"{window['end_text']}.",
                "error"
            )
            return redirect(
                url_for(
                    "faculty_attendance",
                    date=selected_date,
                    timetable_id=timetable_id
                )
            )

        # ----------------------------------------------------
        # Add Absent records for students without attendance
        # ----------------------------------------------------

        absent_added = 0
        finalized_time = datetime.now().strftime("%H:%M:%S")

        try:
            conn.execute("BEGIN")

            students = get_class_students(
                conn,
                timetable
            )

            for student in students:

                exists = conn.execute(
                    """
                    SELECT id
                    FROM attendance
                    WHERE student_id = ?
                      AND timetable_id = ?
                      AND date = ?
                    LIMIT 1
                    """,
                    (
                        student["id"],
                        timetable_id,
                        selected_date
                    )
                ).fetchone()

                if exists:
                    continue

                conn.execute(
                    """
                    INSERT INTO attendance
                    (
                        student_id,
                        timetable_id,
                        date,
                        time,
                        status,
                        confidence
                    )
                    VALUES (?, ?, ?, ?, 'Absent', NULL)
                    """,
                    (
                        student["id"],
                        timetable_id,
                        selected_date,
                        finalized_time
                    )
                )

                absent_added += 1

            conn.commit()

        except Exception:
            conn.rollback()
            app.logger.exception(
                "Failed to finalize faculty attendance "
                "for timetable ID %s on %s",
                timetable_id,
                selected_date
            )

            flash(
                "Attendance could not be finalized. "
                "No partial changes were saved.",
                "error"
            )

            return redirect(
                url_for(
                    "faculty_attendance",
                    date=selected_date,
                    timetable_id=timetable_id
                )
            )

        # ----------------------------------------------------
        # Report success
        # ----------------------------------------------------

        flash(
            f"Attendance finalized successfully. "
            f"{absent_added} absent record(s) added.",
            "success"
        )

        return redirect(
            url_for(
                "faculty_attendance",
                date=selected_date,
                timetable_id=timetable_id,
                finalized="1"
            )
        )

    finally:
        conn.close()

