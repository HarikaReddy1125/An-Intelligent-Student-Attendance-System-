<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Timetable | Intelligent Attendance System</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f6f8;
            color: #1f2937;
        }

        .navbar {
            background: #111827;
            color: white;
            padding: 16px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .navbar h2 {
            font-size: 21px;
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .user-info {
            font-size: 14px;
        }

        .logout {
            text-decoration: none;
            color: white;
            background: #dc2626;
            padding: 8px 14px;
            border-radius: 6px;
            font-size: 14px;
        }

        .logout:hover {
            background: #b91c1c;
        }

        .container {
            max-width: 1400px;
            margin: 30px auto;
            padding: 0 20px;
        }

        .top-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .title-section h1 {
            font-size: 30px;
            margin-bottom: 6px;
        }

        .title-section p {
            color: #6b7280;
        }

        .back-btn {
            text-decoration: none;
            background: #374151;
            color: white;
            padding: 10px 16px;
            border-radius: 7px;
            font-size: 14px;
        }

        .back-btn:hover {
            background: #1f2937;
        }

        .summary {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            margin-bottom: 25px;
        }

        .card {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }

        .card-title {
            font-size: 14px;
            color: #6b7280;
            margin-bottom: 8px;
        }

        .card-value {
            font-size: 25px;
            font-weight: bold;
        }

        .controls {
            background: white;
            padding: 18px;
            border-radius: 10px;
            margin-bottom: 25px;
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }

        .controls input,
        .controls select {
            padding: 11px 13px;
            border: 1px solid #d1d5db;
            border-radius: 7px;
            font-size: 14px;
            outline: none;
        }

        .controls input {
            flex: 1;
            min-width: 250px;
        }

        .controls input:focus,
        .controls select:focus {
            border-color: #2563eb;
        }

        .day-section {
            margin-bottom: 30px;
        }

        .day-title {
            font-size: 21px;
            margin-bottom: 12px;
            padding-left: 5px;
        }

        .table-wrapper {
            background: white;
            border-radius: 10px;
            overflow-x: auto;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 900px;
        }

        th {
            background: #f9fafb;
            color: #4b5563;
            font-size: 13px;
            text-align: left;
            padding: 14px;
            border-bottom: 1px solid #e5e7eb;
        }

        td {
            padding: 14px;
            border-bottom: 1px solid #f0f0f0;
            font-size: 14px;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tr:hover {
            background: #fafafa;
        }

        .time {
            font-weight: bold;
            white-space: nowrap;
        }

        .course-code {
            font-weight: bold;
        }

        .room {
            white-space: nowrap;
        }

        .status {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }

        .active {
            background: #dcfce7;
            color: #166534;
        }

        .inactive {
            background: #fee2e2;
            color: #991b1b;
        }

        .no-results {
            display: none;
            text-align: center;
            padding: 30px;
            color: #6b7280;
            background: white;
            border-radius: 10px;
        }

        @media (max-width: 800px) {
            .summary {
                grid-template-columns: 1fr;
            }

            .top-section {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }

            .navbar {
                padding: 15px;
            }

            .container {
                padding: 0 12px;
            }
        }
    </style>
</head>

<body>

    <div class="navbar">
        <h2>Intelligent Attendance System</h2>

        <div class="nav-right">
            <span class="user-info">
                {{ username }} | {{ role }}
            </span>

            <a href="{{ url_for('logout') }}" class="logout">
                Logout
            </a>
        </div>
    </div>

    <div class="container">

        <div class="top-section">
            <div class="title-section">
                <h1>Class Timetable</h1>
                <p>Manage and view the scheduled classes.</p>
            </div>

            <a href="{{ url_for('dashboard') }}" class="back-btn">
                ← Back to Dashboard
            </a>
        </div>

        <div class="summary">

            <div class="card">
                <div class="card-title">Total Classes</div>
                <div class="card-value">
                    {{ timetable_entries|length }}
                </div>
            </div>

            <div class="card">
                <div class="card-title">Academic Year</div>
                <div class="card-value">
                    {% if timetable_entries %}
                        {{ timetable_entries[0].academic_year or "N/A" }}
                    {% else %}
                        N/A
                    {% endif %}
                </div>
            </div>

            <div class="card">
                <div class="card-title">Class</div>
                <div class="card-value">
                    {% if timetable_entries %}
                        {{ timetable_entries[0].class_name or "N/A" }}
                    {% else %}
                        N/A
                    {% endif %}
                </div>
            </div>

        </div>

        <div class="controls">

            <input
                type="text"
                id="searchInput"
                placeholder="Search subject, faculty, course code, room..."
            >

            <select id="dayFilter">
                <option value="all">All Days</option>
                <option value="Monday">Monday</option>
                <option value="Tuesday">Tuesday</option>
                <option value="Wednesday">Wednesday</option>
                <option value="Thursday">Thursday</option>
                <option value="Friday">Friday</option>
                <option value="Saturday">Saturday</option>
            </select>

        </div>

        {% set days = [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday"
        ] %}

        {% for day in days %}

            {% set day_entries = timetable_entries
                | selectattr("day", "equalto", day)
                | list
            %}

            {% if day_entries %}

                <div
                    class="day-section"
                    data-day-section="{{ day }}"
                >

                    <h2 class="day-title">
                        {{ day }}
                    </h2>

                    <div class="table-wrapper">

                        <table>

                            <thead>
                                <tr>
                                    <th>Time</th>
                                    <th>Course Code</th>
                                    <th>Subject</th>
                                    <th>Faculty</th>
                                    <th>Room</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>

                                {% for entry in day_entries %}

                                    <tr class="timetable-row">

                                        <td class="time">
                                            {{ entry.start_time }}
                                            -
                                            {{ entry.end_time }}
                                        </td>

                                        <td class="course-code">
                                            {{ entry.course_code or "-" }}
                                        </td>

                                        <td>
                                            {{ entry.subject_name or entry.subject or "-" }}
                                        </td>

                                        <td>
                                            {{ entry.faculty_name or entry.faculty or "-" }}
                                        </td>

                                        <td class="room">
                                            {{ entry.room_no or "-" }}
                                        </td>

                                        <td>

                                            {% if entry.active %}
                                                <span class="status active">
                                                    Active
                                                </span>
                                            {% else %}
                                                <span class="status inactive">
                                                    Inactive
                                                </span>
                                            {% endif %}

                                        </td>

                                    </tr>

                                {% endfor %}

                            </tbody>

                        </table>

                    </div>

                </div>

            {% endif %}

        {% endfor %}

        <div id="noResults" class="no-results">
            No timetable entries found.
        </div>

    </div>

    <script>

        const searchInput = document.getElementById("searchInput");
        const dayFilter = document.getElementById("dayFilter");
        const noResults = document.getElementById("noResults");

        function filterTimetable() {

            const searchText =
                searchInput.value.toLowerCase().trim();

            const selectedDay =
                dayFilter.value;

            let visibleRows = 0;

            document
                .querySelectorAll(".day-section")
                .forEach(section => {

                    const sectionDay =
                        section.dataset.daySection;

                    if (
                        selectedDay !== "all" &&
                        sectionDay !== selectedDay
                    ) {
                        section.style.display = "none";
                        return;
                    }

                    let sectionVisibleRows = 0;

                    section
                        .querySelectorAll(".timetable-row")
                        .forEach(row => {

                            const text =
                                row.innerText.toLowerCase();

                            if (text.includes(searchText)) {

                                row.style.display = "";
                                sectionVisibleRows++;
                                visibleRows++;

                            } else {

                                row.style.display = "none";

                            }

                        });

                    if (sectionVisibleRows > 0) {
                        section.style.display = "";
                    } else {
                        section.style.display = "none";
                    }

                });

            if (visibleRows === 0) {
                noResults.style.display = "block";
            } else {
                noResults.style.display = "none";
            }
        }

        searchInput.addEventListener(
            "input",
            filterTimetable
        );

        dayFilter.addEventListener(
            "change",
            filterTimetable
        );

    </script>

</body>
</html>